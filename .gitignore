# --- data: licensed and/or large. Never committed. -------------------------
# Note the single-star patterns: git cannot re-include a file whose parent
# directory has been excluded, so `data/vendor/**` would make the negations
# below silently useless.
data/raw/*
data/cache/*
data/interim/*
data/processed/*
data/vendor/*/*
!data/**/.gitkeep
!data/vendor/schemas/*

# outputs
reports/*
!reports/.gitkeep

# python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# secrets
.env
*.key

# os / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
