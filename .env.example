# Copy to .env and fill in. .env is gitignored - never commit credentials.

# Required for every SEC acquisition. Use your real name and contact email.
SEC_USER_AGENT=

# Optional acquisition defaults. CLI flags take precedence.
DATA_START_DATE=2010-01-01
DATA_END_DATE=

# Optional commercial providers. Leave blank if unused.
POLYGON_API_KEY=
FMP_API_KEY=

# Existing engine path overrides.
EEE_VENDOR_DIR=
EEE_DATA_DIR=
