# Copy to .env and fill in. .env is gitignored - never commit credentials.

# SEC EDGAR requires a descriptive User-Agent with a contact address (it is a
# published condition of use; requests without one get rate-limited or blocked).
SEC_USER_AGENT="earnings-event-engine research (your.email@example.com)"

# Optional commercial providers. Leave blank if unused.
POLYGON_API_KEY=
FMP_API_KEY=

# Where vendor exports are dropped. Defaults to ./data/vendor
EEE_VENDOR_DIR=

# Cache root. Defaults to ./data
EEE_DATA_DIR=
